/// Utilities
pub mod utils {
    /// Generate a unique WebSocket protocol subprotocol
    pub fn generate_protocol() -> String {
        // Generate random string
        "omni-ws-".to_string()
    }
    
    /// Validate WebSocket URL
    pub fn validate_url(url: &str) -> Bool {
        url.starts_with("ws://") || url.starts_with("wss://")
    }
    
    /// Parse WebSocket URL
    pub fn parse_url(url: &str) -> Result<(String, String, String), String> {
        if !validate_url(url) {
            return Err("Invalid WebSocket URL".to_string());
        }
        
        // Simple parsing
        let parts = url.splitn(3, "://").collect::<Vec<_>>();
        if parts.len() < 3 {
            return Err("Invalid WebSocket URL format".to_string());
        }
        
        let scheme = parts[0].to_string();
        let rest = parts[2];
        
        let (host, path) = if let Some(idx) = rest.find('/') {
            (rest[..idx].to_string(), rest[idx..].to_string())
        } else {
            (rest.to_string(), "/".to_string())
        };
        
        Ok((scheme, host, path))
    }
}

// Re-export
pub use std::web::Serialize;
