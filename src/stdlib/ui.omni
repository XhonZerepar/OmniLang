/// Responsive utilities
pub mod responsive {
    /// Breakpoint sizes
    pub struct Breakpoints {
        pub mobile: Int,
        pub tablet: Int,
        pub desktop: Int,
    }
    
    impl Breakpoints {
        pub fn new() -> Breakpoints {
            Breakpoints {
                mobile: 576,
                tablet: 768,
                desktop: 992,
            }
        }
    }
    
    /// Get current breakpoint
    pub fn current_breakpoint() -> String {
        let width = std::web::dom::window().inner_width();
        if width < 576 {
            "mobile".to_string()
        } else if width < 768 {
            "tablet".to_string()
        } else {
            "desktop".to_string()
        }
    }
    
    /// Check if mobile
    pub fn is_mobile() -> Bool {
        current_breakpoint() == "mobile"
    }
    
    /// Check if tablet
    pub fn is_tablet() -> Bool {
        current_breakpoint() == "tablet"
    }
    
    /// Check if desktop
    pub fn is_desktop() -> Bool {
        current_breakpoint() == "desktop"
    }
}

/// CSS class-based animations
pub mod css_animations {
    /// Predefined animation classes
    pub const ANIMATION_FADE_IN: &str = "omni-fade-in";
    pub const ANIMATION_FADE_OUT: &str = "omni-fade-out";
    pub const ANIMATION_SLIDE_IN_LEFT: &str = "omni-slide-in-left";
    pub const ANIMATION_SLIDE_IN_RIGHT: &str = "omni-slide-in-right";
    pub const ANIMATION_BOUNCE: &str = "omni-bounce";
    pub const ANIMATION_SHAKE: &str = "omni-shake";
    pub const ANIMATION_SPIN: &str = "omni-spin";
    pub const ANIMATION_PULSE: &str = "omni-pulse";
    
    /// Add animation class
    pub fn animate(elem: &Element, animation_class: &str) -> () {
        elem.add_class(animation_class);
    }
    
    /// Remove animation class
    pub fn stop_animate(elem: &Element, animation_class: &str) -> () {
        elem.remove_class(animation_class);
    }
}

