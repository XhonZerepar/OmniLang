/// Loss functions
pub mod losses {
    /// Mean squared error
    pub fn mse(pred: &Tensor, target: &Tensor) -> Float {
        let diff = pred - target;
        (diff.clone() * &diff).mean()
    }
    
    /// Cross entropy loss
    pub fn cross_entropy(pred: &Tensor, target: &Tensor) -> Float {
        // Simplified cross entropy
        -(target * &pred.log()).mean()
    }
    
    /// Binary cross entropy
    pub fn binary_cross_entropy(pred: &Tensor, target: &Tensor) -> Float {
        let epsilon = 1e-7;
        let pred = pred.clamp(epsilon, 1.0 - epsilon);
        -((target * &pred.log()) + &((1.0 - target) * &(1.0 - pred).log())).mean()
    }
}

