// Async mutex for shared state
struct Mutex<T> {
    data: T,
    locked: Bool,
}

impl<T> Mutex<T> {
    fn new(data: T) -> Mutex<T> {
        Mutex {
            data,
            locked: false,
        }
    }

    async fn lock(&self) -> MutexGuard<T> {
        // Wait until mutex is available
        while self.locked {
            await sleep(10);
        }
        return MutexGuard { mutex: self };
    }
}

struct MutexGuard<'a, T> {
    mutex: &'a Mutex<T>,
}

impl<'a, T> MutexGuard<'a, T> {
    fn get(&self) -> &T {
        return &self.mutex.data;
    }

    fn get_mut(&mut self) -> &mut T {
        return &mut self.mutex.data;
    }
}

