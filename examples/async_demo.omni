// Example: Async/Await Demonstration
// Demonstrates async/await syntax and concurrent programming

// Async function that simulates a delay
async fn fetch_data(url: String) -> Result<String, String> {
    println("Fetching: " + url);
    
    // Simulate network delay
    await sleep(1000);
    
    return Result::Ok("Data from " + url);
}

// Async function that fetches multiple URLs concurrently
async fn fetch_all(urls: Vec<String>) -> Vec<Result<String, String>> {
    let mut tasks = Vec::new();
    
    // Start all fetch tasks
    for url in urls {
        tasks.push(fetch_data(url));
    }
    
    // Wait for all tasks to complete
    let results = await gather(tasks);
    return results;
}

// Async function that runs multiple tasks concurrently
async fn parallel_example() -> Void {
    println("Starting parallel tasks...");
    
    // Create async tasks
    let task1 = async fn() -> Int {
        await sleep(1000);
        return 1;
    };
    
    let task2 = async fn() -> Int {
        await sleep(500);
        return 2;
    };
    
    let task3 = async fn() -> Int {
        await sleep(200);
        return 3;
    };
    
    // Run all tasks concurrently and wait for results
    let results = await gather([
        task1(),
        task2(),
        task3(),
    ]);
    
    println("Results: " + results);
}

// Async function that demonstrates select/await
async fn race_example() -> Int {
    let task1 = async fn() -> Int {
        await sleep(1000);
        return 1;
    };
    
    let task2 = async fn() -> Int {
        await sleep(500);
        return 2;
    };
    
    // Race - returns as soon as any task completes
    let result = await select(task1(), task2());
    return result;
}

// Async function with error handling
async fn robust_fetch(url: String) -> Result<String, Error> {
    let result = try await fetch_data(url);
    return Result::Ok(result);
}

