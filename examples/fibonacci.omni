// Fibonacci in OmniLang
// Demonstrates recursion and functions

fn fib(n) -> Int:
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

fn main() -> Int:
    let n = 10
    
    print("Fibonacci sequence: ")
    for i in 0..n:
        print(fib(i))
        if i < n - 1:
            print(", ")
    println("")
    
    return 0
