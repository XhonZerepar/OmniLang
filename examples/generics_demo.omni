// Example: Generics Demo
// Demonstrates generic functions and types in OmniLang

// Generic function that swaps two values
fn swap<T>(a: T, b: T) -> (T, T) {
    return (b, a);
}

// Generic function that finds the maximum
fn max<T>(a: T, b: T) -> T where T: Comparable {
    if a > b {
        return a;
    }
    return b;
}

// Generic function that returns the first element
fn first<T>(list: Vec<T>) -> Option<T> {
    return list.get(0);
}

// Generic stack data structure
struct Stack<T> {
    items: Vec<T>,
}

impl<T> Stack<T> {
    fn new() -> Stack<T> {
        Stack {
            items: Vec::new(),
        }
    }

    fn push(&mut self, item: T) -> Void {
        self.items.push(item);
    }

    fn pop(&mut self) -> Option<T> {
        return self.items.pop();
    }

    fn peek(&self) -> Option<&T> {
        if self.items.len() == 0 {
            return Option::None;
        }
        return self.items.get(self.items.len() - 1);
    }

    fn is_empty(&self) -> Bool {
        return self.items.is_empty();
    }

    fn len(&self) -> Int {
        return self.items.len();
    }
}

// Generic queue data structure
struct Queue<T> {
    items: Vec<T>,
}

impl<T> Queue<T> {
    fn new() -> Queue<T> {
        Queue {
            items: Vec::new(),
        }
    }

    fn enqueue(&mut self, item: T) -> Void {
        self.items.push(item);
    }

    fn dequeue(&mut self) -> Option<T> {
        if self.items.len() == 0 {
            return Option::None;
        }
        // Remove from front
        let item = self.items.get(0);
        self.items.remove(0);
        return item;
    }

    fn peek(&self) -> Option<&T> {
        return self.items.get(0);
    }

    fn is_empty(&self) -> Bool {
        return self.items.is_empty();
    }
}

// Generic linked list node
struct ListNode<T> {
    value: T,
    next: Option<ListNode<T>>,
}

impl<T> ListNode<T> {
    fn new(value: T) -> ListNode<T> {
        ListNode {
            value,
            next: Option::None,
        }
    }

    fn append(&mut self, value: T) -> Void {
        match &mut self.next {
            Option::Some(node) => node.append(value),
            Option::None => {
                self.next = Option::Some(ListNode::new(value));
            }
        }
    }
}

// Trait for comparable types
trait Comparable {
    fn compare(&self, other: &Self) -> Int;
}

impl Comparable for Int {
    fn compare(&self, other: &Int) -> Int {
        if *self < *other {
            return -1;
        } else if *self > *other {
            return 1;
        }
        return 0;
    }
}

impl Comparable for Float {
    fn compare(&self, other: &Float) -> Int {
        if *self < *other {
            return -1;
        } else if *self > *other {
            return 1;
        }
        return 0;
    }
}

impl Comparable for String {
    fn compare(&self, other: &String) -> Int {
        if *self < *other {
            return -1;
        } else if *self > *other {
            return 1;
        }
        return 0;
    }
}

// Main function
fn main(args: [String]) -> Int {
    println("=== Generics Demo ===");

    // Test swap
    let (a, b) = swap(5, 10);
    println("swap(5, 10) = (" + a + ", " + b + ")");

    // Test max
    let maximum = max(42, 17);
    println("max(42, 17) = " + maximum);

    // Test stack
    let mut stack = Stack::new();
    stack.push(1);
    stack.push(2);
    stack.push(3);
    println("Stack top: " + stack.peek().unwrap());
    println("Stack pop: " + stack.pop().unwrap());
    println("Stack len: " + stack.len());

    // Test queue
    let mut queue = Queue::new();
    queue.enqueue("hello");
    queue.enqueue("world");
    println("Queue front: " + queue.dequeue().unwrap());
    println("Queue front: " + queue.dequeue().unwrap());

    // Test linked list
    let mut list = ListNode::new(1);
    list.append(2);
    list.append(3);
    println("List created with 3 elements");

    println("=== Demo Complete ===");
    return 0;
}
